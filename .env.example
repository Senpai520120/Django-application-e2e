# Copy to .env and fill it in.
# Key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

DEBUG=True

# Comma-separated, no spaces.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Unset means a SQLite file db.sqlite3 in the project root.
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://users_roles:users_roles@localhost:5432/users_roles

TIME_ZONE=UTC

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# File manager: local is the server disk, s3 is an AWS bucket.
FILE_STORAGE_BACKEND=local
FILE_MANAGER_ROOT=filemanager
FILE_MANAGER_MAX_FILE_SIZE=26214400
FILE_MANAGER_MAX_TOTAL_SIZE=536870912

# Needed only when FILE_STORAGE_BACKEND=s3.
# On EC2 the keys stay unset: access comes from the instance IAM role.
FILE_MANAGER_S3_LOCATION=filemanager
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For a local S3 emulator (localstack):
# AWS_S3_ENDPOINT_URL=http://localstack:4566
# AWS_S3_ADDRESSING_STYLE=path

# Default: the plain backend with DEBUG=True, the whitenoise manifest with False.
# STATICFILES_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage

# Turn on behind a TLS-terminating proxy, or SECURE_SSL_REDIRECT will loop.
USE_X_FORWARDED_PROTO=False

# Turn on behind HTTPS only, or the browser will not keep the cookie.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Behind an HTTPS proxy, for example: https://example.com
# CSRF_TRUSTED_ORIGINS=
